{
  "name": "cleansia-admin.app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/cleansia-admin.app/src",
  "tags": ["scope:admin", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "dependsOn": [],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/cleansia-admin.app",
        "index": "apps/cleansia-admin.app/src/index.html",
        "browser": "apps/cleansia-admin.app/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/cleansia-admin.app/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/cleansia-admin.app/src/assets",
          {
            "glob": "*.woff2",
            "input": "libs/shared/assets/src/fonts",
            "output": "assets/fonts"
          },
          {
            "glob": "**/*.svg",
            "input": "node_modules/flag-icons/flags",
            "output": "assets/flags"
          },
          {
            "glob": "staticwebapp.config.json",
            "input": "apps/cleansia-admin.app/src",
            "output": "/"
          }
        ],
        "styles": [
          "apps/cleansia-admin.app/src/styles.scss",
          "libs/shared/assets/src/styles/cleansia-admin.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/cleansia-admin.app/src/environments/environment.ts",
              "with": "apps/cleansia-admin.app/src/environments/environment.prod.ts"
            }
          ]
        },
        "staging": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/cleansia-admin.app/src/environments/environment.ts",
              "with": "apps/cleansia-admin.app/src/environments/environment.staging.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular-devkit/build-angular:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4201,
        "proxyConfig": "apps/cleansia-admin.app/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "cleansia-admin.app:build:production"
        },
        "development": {
          "buildTarget": "cleansia-admin.app:build:development"
        },
        "devremote": {
          "buildTarget": "cleansia-admin.app:build:development",
          "proxyConfig": "apps/cleansia-admin.app/proxy.devremote.conf.json"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "cleansia-admin.app:build"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/eslint.base.config.mjs",
        "{workspaceRoot}/eslint.module-boundaries.config.mjs",
        "{workspaceRoot}/eslint.generated-dto.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/jest.polyfills.ts",
        {
          "runtime": "node -e \"const c=require('crypto'),f=require('fs'),p=require('path'),h=c.createHash('sha256');const w=x=>f.statSync(x).isDirectory()?f.readdirSync(x).sort().flatMap(e=>['bin','obj'].includes(e)?[]:w(p.join(x,e))):[x];for(const r of process.argv.slice(1))for(const x of w(r))if(x===r||x.endsWith('.cs'))h.update(x).update(f.readFileSync(x));process.stdout.write(h.digest('hex'))\" ../Cleansia.Core.AppServices ../Cleansia.Web.Admin/Controllers ../Cleansia.Core.Domain/Enums/AdminRole.cs ../Cleansia.Core.Domain/Notifications/AdminNotificationEventCatalog.cs"
        },
        {
          "externalDependencies": [
            "jest",
            "@nx/jest",
            "ts-jest",
            "jest-preset-angular"
          ]
        }
      ]
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "cleansia-admin.app:build",
        "port": 4201,
        "staticFilePath": "dist/apps/cleansia-admin.app/browser",
        "spa": true
      }
    }
  }
}
