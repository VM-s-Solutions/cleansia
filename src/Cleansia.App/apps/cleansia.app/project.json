{
  "name": "cleansia.app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/cleansia.app/src",
  "tags": ["scope:customer", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "dependsOn": [],
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/cleansia.app",
        "index": "apps/cleansia.app/src/index.html",
        "browser": "apps/cleansia.app/src/main.ts",
        "server": "apps/cleansia.app/src/main.server.ts",
        "ssr": {
          "entry": "apps/cleansia.app/server.ts"
        },
        "polyfills": ["zone.js"],
        "tsConfig": "apps/cleansia.app/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/cleansia.app/src/assets",
          {
            "glob": "*.woff2",
            "input": "libs/shared/assets/src/fonts",
            "output": "assets/fonts"
          },
          {
            "glob": "**/*.svg",
            "input": "node_modules/flag-icons/flags",
            "output": "assets/flags"
          },
          {
            "glob": "robots.txt",
            "input": "apps/cleansia.app/src/root-assets",
            "output": "/"
          },
          {
            "glob": "**/*",
            "input": "apps/cleansia.app/src/root-assets/well-known",
            "output": "/.well-known",
            "ignore": ["**/*.md"]
          }
        ],
        "styles": [
          "apps/cleansia.app/src/styles.scss",
          "libs/shared/assets/src/styles/cleansia-customer.scss"
        ]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "fileReplacements": [
            {
              "replace": "apps/cleansia.app/src/environments/environment.ts",
              "with": "apps/cleansia.app/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2.5mb",
              "maximumError": "5mb"
            }
          ]
        },
        "staging": {
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "fileReplacements": [
            {
              "replace": "apps/cleansia.app/src/environments/environment.ts",
              "with": "apps/cleansia.app/src/environments/environment.staging.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2.5mb",
              "maximumError": "5mb"
            }
          ]
        },
        "development": {
          "optimization": false,
          "sourceMap": true,
          "namedChunks": true,
          "extractLicenses": false
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4202,
        "proxyConfig": "apps/cleansia.app/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "cleansia.app:build:production"
        },
        "development": {
          "buildTarget": "cleansia.app:build:development"
        },
        "devremote": {
          "buildTarget": "cleansia.app:build:development",
          "proxyConfig": "apps/cleansia.app/proxy.devremote.conf.json"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "cleansia.app:build"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/eslint.base.config.mjs",
        "{workspaceRoot}/eslint.module-boundaries.config.mjs",
        "{workspaceRoot}/eslint.generated-dto.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/jest.polyfills.ts",
        "bookingPolicy",
        {
          "runtime": "node -e \"const c=require('crypto'),f=require('fs'),p=require('path'),h=c.createHash('sha256');const w=x=>f.statSync(x).isDirectory()?f.readdirSync(x).sort().flatMap(e=>['bin','obj'].includes(e)?[]:w(p.join(x,e))):[x];for(const r of process.argv.slice(1))for(const x of w(r))if(x===r||x.endsWith('.cs'))h.update(x).update(f.readFileSync(x));process.stdout.write(h.digest('hex'))\" ../Cleansia.Core.AppServices ../Cleansia.Web.Customer/Controllers ../Cleansia.Core.Domain/Orders/Order.cs ../Cleansia.Core.Domain/Users/SavedCard.cs ../Cleansia.Core.Domain/Disputes/DisputeLimits.cs ../../sql-scripts/prod-bootstrap.sql"
        },
        {
          "externalDependencies": [
            "jest",
            "@nx/jest",
            "ts-jest",
            "jest-preset-angular"
          ]
        }
      ]
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "cleansia.app:build",
        "port": 4202,
        "staticFilePath": "dist/apps/cleansia.app/browser",
        "spa": true
      }
    }
  }
}
