{
  "name": "components",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/components/src",
  "prefix": "cleansia",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/jest.polyfills.ts",
        "{workspaceRoot}/libs/shared/assets/src/styles/common/touch-target.scss",
        "{workspaceRoot}/libs/shared/assets/src/styles/components/cleansia-button.component.scss",
        "{workspaceRoot}/libs/shared/assets/src/styles/components/cleansia-mobile-toolbar.component.scss",
        "{workspaceRoot}/libs/shared/assets/src/styles/components/cleansia-sidebar-menu.component.scss",
        "{workspaceRoot}/libs/shared/assets/src/styles/components/cleansia-table.component.scss",
        "{workspaceRoot}/libs/shared/assets/src/styles/components/cleansia-text-input.component.scss",
        "{workspaceRoot}/libs/**/*.component.html",
        "{workspaceRoot}/apps/**/*.component.html",
        "{workspaceRoot}/apps/*/src/assets/i18n/*.json",
        "{workspaceRoot}/libs/core/*-services/src/lib/client/*-client.ts",
        {
          "externalDependencies": [
            "jest",
            "@nx/jest",
            "ts-jest",
            "jest-preset-angular"
          ]
        }
      ]
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/eslint.base.config.mjs",
        "{workspaceRoot}/eslint.module-boundaries.config.mjs",
        "{workspaceRoot}/eslint.generated-dto.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
