{
  "name": "models",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/models/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["scope:shared", "type:util"],
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/jest.polyfills.ts",
        "{workspaceRoot}/libs/core/*-services/src/lib/client/*.ts",
        {
          "externalDependencies": [
            "jest",
            "@nx/jest",
            "ts-jest",
            "jest-preset-angular"
          ]
        }
      ]
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/eslint.base.config.mjs",
        "{workspaceRoot}/eslint.module-boundaries.config.mjs",
        "{workspaceRoot}/eslint.generated-dto.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
