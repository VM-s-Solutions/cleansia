{
  "name": "@cleansia.app/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:cleansia": "nx serve cleansia.app --configuration=development",
    "start:cleansia-partner": "nx serve cleansia-partner.app --configuration=development",
    "start:cleansia-admin": "nx serve cleansia-admin.app --configuration=development",
    "build": "nx build cleansia.app --configuration=development",
    "build:prod": "nx build cleansia.app --configuration=production",
    "build:cleansia-partner": "nx build cleansia-partner.app --configuration=production",
    "build:cleansia-customer": "nx build cleansia.app --configuration=production",
    "build:cleansia-admin": "nx build cleansia-admin.app --configuration=production",
    "start:cleansia-ssr": "nx build cleansia.app --configuration=development && node dist/apps/cleansia.app/server/server.mjs",
    "test": "nx e2e cleansia.app-e2e",
    "lint": "nx lint",
    "e2e": "nx e2e",
    "typecheck": "node tools/typecheck-apps.mjs",
    "typecheck:test": "node tools/typecheck-apps.test.mjs",
    "//": "_nswag:* are internal composition steps, not entry points. No script that invokes NSwag may be runnable without ending in `npm run typecheck` (ADR-0031 D1).",
    "_nswag:partner": "npx nswag run nswag-partner.json && bash partner-client-formatter.sh",
    "_nswag:admin": "npx nswag run nswag-admin.json && bash admin-client-formatter.sh",
    "_nswag:customer": "npx nswag run nswag-customer.json && bash customer-client-formatter.sh",
    "generate-partner-client": "npm run _nswag:partner && npm run typecheck",
    "generate-admin-client": "npm run _nswag:admin && npm run typecheck",
    "generate-customer-client": "npm run _nswag:customer && npm run typecheck",
    "generate-clients": "npm run _nswag:partner && npm run _nswag:admin && npm run _nswag:customer && npm run typecheck"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "~22.1.4",
    "@angular/common": "~22.1.4",
