<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cleansia.Core.Domain\Cleansia.Core.Domain.csproj" />
    <!-- ADR-0002 D3 (F3) — DeadLetterStore implements IDeadLetterStore (the internal queue contract). -->
    <ProjectReference Include="..\Cleansia.Core.Queue.Abstractions\Cleansia.Core.Queue.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Migrations\" />
  </ItemGroup>

  <!--
    The legal texts. The folder path is the document's identity (audience / type / market / effective
    date / language) and the file is the text -> Seed/Legal/LegalSeedResource.cs. A new version is a
    new dated folder; a file under a date already in force is never applied.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Seed\Legal\**\*.md" LogicalName="Seed/Legal/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
