{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "CorsOrigins": [],
    "Sentry": {
        "Dsn": ""
    },
    "ConnectionStrings": {
        "BlobContainerConfigurationConnectionString": "UseDevelopmentStorage=true",
        "QueueStorageConnectionString": "UseDevelopmentStorage=true",
        "ConnectionString": "SET_VIA_USER_SECRETS"
    },
    "JwtSettings": {
        "Secret": "SET_VIA_USER_SECRETS",
        "AccessTokenExpMinutes": 1440,
        "RefreshTokenExpDays": 30,
        "RefreshTokenShortExpDays": 1
    },
    "Csrf": {
        "Enabled": false,
        "Secret": "SET_VIA_USER_SECRETS"
    },
    "Apple": {
        // This host deliberately carries NO BundleId. It issues HttpOnly session cookies, so accepting
        // the native audience would let a captured iOS (identityToken, rawNonce) pair POSTed here mint a
        // browser session. Web accepts the Services ID and nothing else; the mobile host is the mirror
        // image and carries BundleId only. AppleAudienceIsolationConfigPinTests pins both directions.
        // Blank until the owner provisions it — AppleTokenVerifier then fails closed rather than leaving
        // the audience check unconstrained.
        "WebServicesId": ""
    },
    "Google": {
        // Blank here on purpose, exactly like Apple:WebServicesId above. A deployed host gets its id
        // from the Bicep-managed app setting Google__ClientId, which is per-environment; local runs get
        // it from appsettings.Development.json. Hardcoding a value here would make PROD silently inherit
        // DEV's client on any deploy that forgot to set the app setting, and GoogleTokenVerifier pins a
        // single audience — so it must be the client of THIS environment or every web sign-in fails with
        // auth.invalid_google_token. It is also a DIFFERENT client from the mobile host's native one,
        // whose tokens must never be accepted here.
        "ClientId": ""
    },
    "Stripe": {
        "SecretKey": "SET_VIA_USER_SECRETS",
        "PublishableKey": "SET_VIA_USER_SECRETS",
        "WebhookSecret": "SET_VIA_USER_SECRETS",
        "WebhookUrl": "/api/payments/webhook",
        // 4202, not 4200. Stripe returns the browser to these, and 4200 is the PARTNER dev app —
        // which has no `checkout` route, so its `**` catch-all served the paying customer a
        // partner-branded not-found page. The header back-arrow in Stripe Checkout goes to
        // CancelUrl, so backing out of payment landed there too.
        //
        // This host is the ONLY one that mints an order Checkout Session (ServiceExtensions
        // registers OrderChannel.Web; OrderPaymentDispatcher returns without a session on Mobile),
        // so it is the only place these two keys are ever read. Production is already right — the
        // customer SSR host IS the apex — which is what says this drifted rather than was designed.
        "SuccessUrlBase": "http://localhost:4202/checkout/success",
        "CancelUrlBase": "http://localhost:4202/checkout/cancel"
    },
    "BlobContainerConfiguration": {
        "ConnectionStringName": "BlobContainerConfigurationConnectionString"
    },
    "SendGrid": {
        "ApiKey": "SET_VIA_USER_SECRETS",
        "AddressFrom": "it@cleansia.cz",
        "ResetPasswordUrl": "http://localhost:4200/forgot-password",
        "OrderStatusUrl": "http://localhost:4200/orders"
    },
    "Mapbox": {
        "GeocodingAccessToken": "",
        "DefaultCountryIsoCode": "cz"
    },
    "Fiscal": {
        "CzechEet2": {
            "ApiUrl": "",
            "ApiKey": "",
            "CertificatePath": "",
            "CertificatePassword": "",
            "TaxpayerIdentifier": "",
            "BusinessPremiseId": "",
            "CashRegisterId": "",
            "Enabled": false
        }
    }
}
