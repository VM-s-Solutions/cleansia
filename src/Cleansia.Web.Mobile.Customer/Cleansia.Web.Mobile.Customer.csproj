<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b4d8f5e2-ae3c-5b9f-c7f1-2f6e4d8aa3c0</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

    <!--
      Do NOT re-enable. See the long-form explanation in Cleansia.Web.Partner.csproj.

      Short version: `dotnet ef` on macOS creates a directory whose NAME literally contains a
      backslash — `bin\Debug`. MSBuild's glob walker enumerates that entry, normalizes the '\'
      to '/', and then reads the REAL bin/Debug. The SDK's `bin/**` default exclude never fires
      because the entry is not NAMED `bin`. Microsoft.NET.Sdk.Web's default
      `<Content Include="**\*.json" CopyToOutputDirectory="PreserveNewest">` therefore ingests
      this project's OWN output and re-copies it one level deeper on every build, and the copies
      flow on to Cleansia.Tests / Cleansia.HostTests via ProjectReference until MSB3021
      (path too long). No exclude pattern can fix it — MSBuild normalizes '\' to '/' in patterns
      on Unix, so no pattern can name the aliased entry. Dropping the recursive content glob is
      the only structural fix.

      This host is only exposed when it is the EF startup project, but the blast radius is the
      whole build, so all five Web hosts carry the same guard.

      Measured on Cleansia.Web.Mobile.Partner with `dotnet msbuild -getItem:Content`:
      3 items clean -> 9 with an empty `bin\Debug` present -> 21 after two more builds.
      The items below are the exact set the default glob produced here (verified the same way):
      the three appsettings files plus libman.json. libman.json is a design-time LibMan manifest
      with an empty library list and is not needed at runtime, but it WAS being copied before this
      change, so it stays listed to keep the output byte-identical rather than silently dropping it.
      launchSettings.json was already excluded by the SDK's DefaultWebContentItemExcludes;
      this project has no wwwroot and no .config, so nothing else is lost.
    -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings.json" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="appsettings.*.json" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="libman.json" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cleansia.Config\Cleansia.Config.csproj" />
    <ProjectReference Include="..\Cleansia.Core.AppServices\Cleansia.Core.AppServices.csproj" />
    <ProjectReference Include="..\Cleansia.Infra.Common\Cleansia.Infra.Common.csproj" />
    <ProjectReference Include="..\Cleansia.ServiceDefaults\Cleansia.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
