<?xml version="1.0" encoding="utf-8"?>
<!--
    :core owns only the strings that :core's own composables render. Every key
    MUST carry the `core_` prefix: library resources are merged INTO each app's
    resource table, and on a name collision the APP's value silently wins with
    no warning. The prefix is the only thing keeping that from happening.

    Android CI runs compileDebugKotlin + testDebugUnitTest and no lint, so a key
    added here but missing from values-cs/sk/uk/ru compiles, ships, and renders
    English. Add to all five files in the same edit.
-->
<resources>
    <string name="core_search">Search</string>
    <string name="core_snackbar_dismiss">Dismiss</string>
    <string name="core_consent_toggle">Accept terms and privacy policy</string>
    <string name="core_error_server">Server is temporarily unavailable. Try again later.</string>
    <string name="core_error_timeout">Connection timeout. Please try again.</string>
    <string name="core_error_no_connection">Check your internet connection and try again.</string>
    <string name="core_error_not_found">The requested resource was not found.</string>
    <string name="core_error_unauthorized">Your session expired. Please sign in again.</string>
    <string name="core_error_unknown">Something went wrong. Please try again.</string>
</resources>
