<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      READ_EXTERNAL_STORAGE and READ_MEDIA_IMAGES are deliberately absent. Both gallery pickers
      (PhotosSection.kt, DocumentsSectionScreen.kt) go through the system picker, which returns a
      URI already carrying a read grant — no permission at any API level. Declaring them would
      also oblige the Play "Photo and video permissions" declaration for an app that never touches
      the media store. Do not add them back.

      CAMERA was removed with them on 2026-08-18 for a different and now-expired reason: it had no
      call site. It has one as of 2026-08-27 — a cleaner can photograph a job or their avatar
      without going through the gallery, which both iOS apps have always been able to do.

      The uses-feature below is NOT optional decoration. Without it, Play infers a declared CAMERA
      permission as REQUIRED hardware and filters the store listing to devices that have it; with
      required="false" the app still installs on a device with no camera, which is why the capture
      path checks PackageManager.FEATURE_CAMERA_ANY before it offers the choice. Removing one of
      these two lines without the other reintroduces the exact bug the 2026-08-18 removal fixed.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".CleansiaPartnerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CleansiaPartner"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection"
            android:theme="@style/Theme.CleansiaPartner.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="partner.cleansia.cz" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cleansia" android:host="partner" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="partner.cleansia.cz"
                    android:pathPrefix="/confirm-email" />
            </intent-filter>
        </activity>

        <!-- FCM message receiver. android:exported="false" — only the system
             can deliver MESSAGING_EVENT to this service. -->
        <service
            android:name=".core.notifications.CleansiaFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default small icon + channel for any FCM `notification`-type
             message that bypasses our data-only handler (defensive — our
             dispatches are data-only). The channel id matches the order-updates
             channel registered in NotificationChannels. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="cleansia.partner.notification.order_updates" />

        <!-- Sentry's auto-init ContentProvider crashes the app when the DSN is blank, which is
             every dev machine without SENTRY_DSN set. Partner used to delete the provider outright;
             the customer app turns auto-init off and initialises explicitly in the Application,
             guarded on the DSN. Mirroring that rather than keeping two answers to one question. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <!-- FileProvider — exposes cacheDir/invoices/*.pdf to the system
             viewer when the user taps "Open invoice" on an invoice detail. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
