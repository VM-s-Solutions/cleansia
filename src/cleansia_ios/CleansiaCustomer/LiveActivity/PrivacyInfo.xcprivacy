<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	     The Live Activity extension collects nothing of its own — it renders an order the host app
	     already has. It still needs the UserDefaults declaration: it links CleansiaCore, which is a
	     SOURCE SPM package with no manifest of its own, so those symbols compile into this binary.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults, two reasons.
		     CA92.1: CleansiaCore's settings code, which compiles into this binary (see above).
		     1C8F.1: the card reads the in-app language the host app writes into their shared App
		     Group (AppGroupLanguage), so it renders in the language the app does. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
