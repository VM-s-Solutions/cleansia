    "home_upsell_notifications_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We tell you when they set off, start and finish."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dáme vědět, když vyrazí, začne i skončí."
