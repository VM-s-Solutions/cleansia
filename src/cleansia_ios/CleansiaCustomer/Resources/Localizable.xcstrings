    "push.order.no_cleaner_nothing_charged.body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na objednávku #%1$@ nemohl dorazit žádný uklízeč, proto jsme ji zrušili. Nic jsme vám neúčtovali a přidali jsme vám kredit %2$@ na příští úklid. Omlouváme se."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cleaner could make it to booking #%1$@, so we have cancelled it. You have not been charged, and we have added %2$@ credit towards your next clean. Sorry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На заказ #%1$@ не смог приехать ни один уборщик, поэтому мы его отменили. Мы ничего с вас не списали, а ещё начислили %2$@ кредита на следующую уборку. Простите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na objednávku #%1$@ nemohol prísť žiadny upratovač, preto sme ju zrušili. Nič sme vám neúčtovali a pridali sme vám kredit %2$@ na ďalšie upratovanie. Ospravedlňujeme sa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На замовлення #%1$@ не зміг приїхати жоден прибиральник, тому ми його скасували. Ми нічого з вас не списали, а ще нарахували %2$@ кредиту на наступне прибирання. Вибачте."
          }
        }
      }
    },
    "push.order.no_cleaner_nothing_charged.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný uklízeč nebyl k dispozici"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
