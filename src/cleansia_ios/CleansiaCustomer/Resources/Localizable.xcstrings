    "recurring_cash_change_action": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravit rozvrh"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the schedule"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить расписание"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upraviť rozvrh"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінити розклад"
          }
        }
      }
    },
    "recurring_cash_change_body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý úklid potřebuje více než jednoho uklízeče a hotově lze platit jen úklidy, které zvládne jeden uklízeč, proto se z něj neobjednávají žádné nové úklidy, dokud ho nezměníte. Přepněte ho na platbu kartou nebo vyberte služby či balíčky, které zvládne jeden uklízeč. Úklid, který už je z něj objednaný, můžete v Objednávkách zrušit zdarma, dokud ho nepřijme žádný uklízeč."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each clean needs more than one cleaner, and cash is only for cleans one cleaner handles alone, so no new cleanings are booked from it until you change it. Switch it to card, or pick services or packages one cleaner can do. A cleaning already booked from it can be cancelled free of charge in Orders while no cleaner has taken it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для каждой уборки нужно больше одного уборщика, а наличными можно платить только за уборки, с которыми справится один уборщик, поэтому новые уборки по нему не заказываются, пока вы его не измените. Переведите его на оплату картой или выберите услуги либо пакеты, с которыми справится один уборщик. Уборку, которая уже заказана по нему, можно бесплатно отменить в Заказах, пока её не взял ни один уборщик."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé upratovanie potrebuje viac ako jedného upratovača a v hotovosti sa dá platiť len za upratovania, ktoré zvládne jeden upratovač, preto sa z neho neobjednávajú žiadne nové upratovania, kým ho nezmeníte. Prepnite ho na platbu kartou alebo vyberte služby či balíky, ktoré zvládne jeden upratovač. Upratovanie, ktoré je z neho už objednané, môžete v Objednávkach zrušiť zadarmo, kým ho neprijme žiadny upratovač."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для кожного прибирання потрібен більш ніж один прибиральник, а готівкою можна платити лише за прибирання, з якими впорається один прибиральник, тому нові прибирання за ним не замовляються, доки ви його не зміните. Переведіть його на оплату карткою або оберіть послуги чи пакети, з якими впорається один прибиральник. Прибирання, яке вже замовлено за ним, можна безкоштовно скасувати в Замовленнях, поки його не взяв жоден прибиральник."
          }
        }
      }
    },
    "recurring_cash_change_title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento rozvrh už nelze platit hotově"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This schedule can no longer be paid in cash"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это расписание больше нельзя оплачивать наличными"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento rozvrh sa už nedá platiť v hotovosti"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей розклад більше не можна оплачувати готівкою"
          }
        }
      }
    },
    "recurring_cash_cleared": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platba hotově už pro tento rozvrh není možná, a proto není vybrán žádný způsob platby. Zvolte, jak chcete platit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash is no longer available for this schedule, so no payment method is selected. Choose how you want to pay."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата наличными для этого расписания больше недоступна, поэтому способ оплаты не выбран. Выберите, как вы хотите платить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platba v hotovosti už pre tento rozvrh nie je možná, preto nie je vybraný žiadny spôsob platby. Zvoľte, ako chcete platiť."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата готівкою для цього розкладу більше недоступна, тому спосіб оплати не обрано. Оберіть, як ви хочете платити."
          }
        }
      }
    },
    "recurring_cash_needs_card": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet uklízečů potřebných na každý úklid: %d. Hotově lze platit jen úklidy, které zvládne jeden uklízeč, tento rozvrh proto platíte kartou."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleaners needed for each clean: %d. Cash is only for cleans one cleaner handles alone, so this schedule is paid by card."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Количество уборщиков для каждой уборки: %d. Наличными можно платить только за уборки, с которыми справится один уборщик, поэтому это расписание оплачивается картой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet upratovačov potrebných na každé upratovanie: %d. V hotovosti sa dá platiť len za upratovania, ktoré zvládne jeden upratovač, tento rozvrh preto platíte kartou."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кількість прибиральників для кожного прибирання: %d. Готівкою можна платити лише за прибирання, з якими впорається один прибиральник, тож цей розклад сплачується карткою."
          }
        }
      }
    },
    "recurring_cash_pending": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zda lze tento rozvrh platit hotově, potvrdíme, jakmile bude známa cena."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether this schedule can be paid in cash is confirmed once the price is ready."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно ли оплачивать это расписание наличными, мы подтвердим, как только будет известна цена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Či sa dá tento rozvrh platiť v hotovosti, potvrdíme, keď bude známa cena."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи можна платити за цей розклад готівкою, ми підтвердимо, щойно буде відома ціна."
          }
        }
      }
    },
    "recurring_cash_unchecked": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se ověřit, zda lze tento rozvrh platit hotově. Uložte ho za chvíli znovu, nebo zvolte kartu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't confirm whether this schedule can be paid in cash. Save it again in a moment, or choose card."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить, можно ли оплачивать это расписание наличными. Сохраните его ещё раз через минуту или выберите карту."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa overiť, či sa dá tento rozvrh platiť v hotovosti. Uložte ho o chvíľu znova alebo zvoľte kartu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перевірити, чи можна платити за цей розклад готівкою. Збережіть його ще раз за хвилину або оберіть картку."
          }
        }
      }
    },
