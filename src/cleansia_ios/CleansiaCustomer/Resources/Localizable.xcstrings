    "booking_express_waiver_available": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pokrývá 20% expresní příplatek — %1$d zbývá tento kalendářní měsíc."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus covers the 20% express surcharge — %1$d left this calendar month."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus покрывает 20 % экспресс-доплаты — %1$d осталось в этом календарном месяце."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pokrýva 20% expresný príplatok — %1$d zostáva tento kalendárny mesiac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus покриває 20 % експрес-доплати — %1$d залишилось цього календарного місяця."
          }
        }
      }
    },
    "booking_express_waiver_used": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento měsíc už nezbývá žádné odpuštění expresního příplatku — expresní termíny se účtují s +20 % až do příštího měsíce."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No express waivers left this month — express slots are charged at +20% until next month."
          }
        },
        "ru": {
