    "onboarding_phone_helper": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uveďte předčíslí (např. +420). Použijeme ho pouze k tomu, abychom vás kontaktovali ohledně vašich rezervací."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include your country code (e.g. +420). We'll only use this to reach you about your bookings."
