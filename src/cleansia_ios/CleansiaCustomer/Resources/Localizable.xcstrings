    "booking_cash_cleared": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platba hotově už pro tuto objednávku není možná, a proto není vybrán žádný způsob platby. Zvolte, jak chcete platit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash is no longer available for this booking, so no payment method is selected. Choose how you want to pay."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата наличными для этого заказа больше недоступна, поэтому способ оплаты не выбран. Выберите, как вы хотите платить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platba v hotovosti už pre túto objednávku nie je možná, preto nie je vybraný žiadny spôsob platby. Zvoľte, ako chcete platiť."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата готівкою для цього замовлення більше недоступна, тому спосіб оплати не обрано. Оберіть, як ви хочете платити."
          }
        }
      }
    },
    "booking_card_guarantee_title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta jako záruka plateb v hotovosti"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card to guarantee cash bookings"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта как гарантия для оплаты наличными"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta ako záruka platieb v hotovosti"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка як гарантія для оплати готівкою"
          }
        }
      }
    },
    "booking_card_guarantee_body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při první objednávce v hotovosti si uložíte kartu. Nic se teď nestrhává: za úklid zaplatíte v hotovosti jako obvykle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first cash booking saves a card. Nothing is charged now: you still pay the cleaner in cash."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При первом заказе с оплатой наличными вы сохраняете карту. Сейчас ничего не списывается: за уборку вы платите наличными, как обычно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri prvej objednávke v hotovosti si uložíte kartu. Teraz sa nič nestrháva: za upratovanie zaplatíte v hotovosti ako zvyčajne."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час першого замовлення з оплатою готівкою ви зберігаєте картку. Зараз нічого не списується: за прибирання ви платите готівкою, як завжди."
          }
        }
      }
    },
    "booking_contract_notice": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrzením objednávky uzavíráte smlouvu o úklidu s provozní společností trhu, na kterém se vaše domácnost nachází, za jejích [Podmínek služby](cleansia://terms). Úklid provede uklízeč jako subdodavatel společnosti a stranou vaší smlouvy není."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By confirming the order you conclude a contract for the cleaning with the operating company of the market where your home is, under its [Terms of Service](cleansia://terms). The cleaner carries it out as a subcontractor of the company and is not a party to your contract."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждая заказ, вы заключаете договор на уборку с операционной компанией рынка, на котором находится ваше жильё, в соответствии с её [Условиями использования](cleansia://terms). Уборку выполняет уборщик как субподрядчик компании, и он не является стороной вашего договора."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdením objednávky uzatvárate zmluvu o upratovaní s prevádzkovou spoločnosťou trhu, na ktorom sa vaša domácnosť nachádza, za jej [Podmienok služby](cleansia://terms). Upratovanie vykoná upratovač ako subdodávateľ spoločnosti a stranou vašej zmluvy nie je."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтверджуючи замовлення, ви укладаєте договір про прибирання з операційною компанією ринку, на якому розташоване ваше житло, відповідно до її [Умов використання](cleansia://terms). Прибирання виконує прибиральник як субпідрядник компанії, і він не є стороною вашого договору."
          }
        }
      }
    },
