    "preferred_offer_closed_body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádost o uklízeče, kterého jste si vyžádali, skončila. Tato rezervace je nyní otevřená celému našemu týmu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request for the cleaner you asked for has ended. This booking is now open to our whole team."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос на клинера, которого вы выбрали, завершён. Этот заказ теперь открыт для всей нашей команды."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadosť o upratovača, ktorého ste si vyžiadali, sa skončila. Táto rezervácia je teraz otvorená celému nášmu tímu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит на клінера, якого ви обрали, завершено. Це замовлення тепер відкрите для всієї нашої команди."
          }
        }
      }
    },
