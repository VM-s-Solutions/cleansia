    "onboarding_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pár rychlých údajů, abychom vám mohli lépe posloužit. Můžete tento krok přeskočit a vyplnit později."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few quick details so we can serve you better. You can skip and fill these in later."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немного деталей, чтобы мы могли лучше вас обслуживать. Можно пропустить и заполнить позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pár rýchlych údajov, aby sme vám mohli lepšie slúžiť. Môžete tento krok preskočiť a vyplniť neskôr."
          }
        },
        "uk": {
