    "delete_account_dialog_message": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše osobní údaje budou odstraněny a tuto akci nelze vrátit; záznamy uvedené na této obrazovce uchováme po dobu, kterou uvádí. Nevyčerpaný kredit na účtu dokončením smazání propadá — nelze ho vyplatit ani obnovit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your personal details are removed and this cannot be undone; the records listed on this screen are kept for the periods it states. Any unused credit on your account is forfeited once the deletion completes — it cannot be paid out or restored."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши персональные данные будут удалены, и это действие нельзя отменить; записи, перечисленные на этом экране, мы храним в течение указанных на нём сроков. Неиспользованный кредит на счёте аннулируется, как только удаление завершится, — его нельзя выплатить или восстановить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše osobné údaje budú odstránené a túto akciu nie je možné vrátiť; záznamy uvedené na tejto obrazovke uchováme počas doby, ktorú uvádza. Nevyčerpaný kredit na účte dokončením vymazania prepadá — nedá sa vyplatiť ani obnoviť."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші персональні дані буде видалено, і цю дію неможливо скасувати; записи, перелічені на цьому екрані, ми зберігаємо протягом зазначених на ньому строків. Невикористаний кредит на рахунку анулюється, щойно видалення завершиться, — його не можна виплатити чи відновити."
          }
        }
      }
    },
