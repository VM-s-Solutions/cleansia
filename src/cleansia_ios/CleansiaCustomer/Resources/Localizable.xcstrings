    "help_faq_a1": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete rezervaci na kartě Objednávky a klepněte na „Zrušit“. Zrušení je zdarma až 24 hodin před začátkem úklidu. Do 15 minut od objednání neplatíte nic — u první objednávky nebo s Cleansia Plus do 60 minut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your booking from the Orders tab and tap \"Cancel\". Cancellations are free up to 24 hours before the cleaning start time. Within 15 minutes of booking you pay nothing — within 60 minutes on your first booking or with Cleansia Plus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте заказ на вкладке Заказы и нажмите «Отменить». Отмена бесплатна за 24 часа до начала уборки. В течение 15 минут после заказа вы не платите ничего — для первого заказа или с Cleansia Plus в течение 60 минут."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte rezerváciu na karte Objednávky a ťuknite na „Zrušiť“. Zrušenie je zdarma až 24 hodín pred začiatkom upratovania. Do 15 minút od objednania neplatíte nič — pri prvej objednávke alebo s Cleansia Plus do 60 minút."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте бронювання на вкладці Замовлення і натисніть «Скасувати». Скасування безкоштовне за 24 години до початку прибирання. Протягом 15 хвилин після замовлення ви не платите нічого — для першого замовлення або з Cleansia Plus протягом 60 хвилин."
          }
        }
      }
    },
    "help_faq_a2": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při rezervaci přidejte pokyny ke vstupu (např. kód u dveří, místo klíče). Uklízeč čeká 15 minut po začátku úklidu a zkusí vám zavolat. Pokud se ani pak nedostane dovnitř, rezervace se zruší a účtuje se plná cena."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add access instructions when booking (e.g., door code, key location). The cleaner waits 15 minutes past the start time and tries to call you. If they still can't get in, the booking is cancelled and the full price is charged."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте инструкции по доступу при бронировании (напр. код от двери, место ключа). Клинер ждёт 15 минут после начала уборки и пытается вам позвонить. Если и тогда не удастся попасть внутрь, бронирование отменяется и взимается полная стоимость."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri rezervácii pridajte pokyny ku vstupu (napr. kód pri dverách, miesto kľúča). Upratovačka čaká 15 minút po začiatku upratovania a skúsi vám zavolať. Ak sa ani potom nedostane dnu, rezervácia sa zruší a účtuje sa plná cena."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте інструкції щодо доступу при бронюванні (напр. код від дверей, місце ключа). Клінер чекає 15 хвилин після початку прибирання і намагається вам зателефонувати. Якщо й тоді не вдасться потрапити всередину, бронювання скасовується і стягується повна вартість."
          }
        }
      }
    },
    "help_faq_a3_no_figure": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano. Všichni uklízeči Cleansia jsou pojištěni."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. All Cleansia cleaners are covered by insurance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да. Все клинеры Cleansia застрахованы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Áno. Všetci upratovači Cleansia sú poistení."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так. Усі клінери Cleansia застраховані."
          }
        }
      }
    },
    "help_faq_a3": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano. Všichni uklízeči Cleansia jsou pojištěni až do %1$@ na rezervaci."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. All Cleansia cleaners are covered by insurance up to %1$@ per booking."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да. Все клинеры Cleansia застрахованы до %1$@ за заказ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Áno. Všetci upratovači Cleansia sú poistení až do %1$@ na rezerváciu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так. Усі клінери Cleansia застраховані до %1$@ за бронювання."
          }
        }
      }
    },
    "help_faq_a4": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezervaci nelze přesunout na jiný termín. Zrušte ji a objednejte nový termín — zrušení je zdarma, dokud práci nepřevzal žádný uklízeč."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A booking can't be moved to another date. Cancel it and book the new date instead — cancelling is free while no cleaner has taken the job."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заказ нельзя перенести на другую дату. Отмените его и закажите новую дату — отмена бесплатна, пока ни один клинер не взял заказ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezerváciu nemožno presunúť na iný termín. Zrušte ju a objednajte nový termín — zrušenie je zadarmo, kým prácu neprevzal žiadny upratovač."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бронювання не можна перенести на іншу дату. Скасуйте його та замовте нову дату — скасування безкоштовне, поки жоден клінер не взяв замовлення."
          }
        }
      }
    },
    "help_faq_a5": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuchyně, koupelny, všechny podlahy, utírání prachu a úklid. Extra služby jako čištění trouby jsou jako doplňky."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitchen, bathrooms, all floors, dusting, and general tidying. Extras like oven cleaning are available as add-ons."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кухня, ванные, все полы, протирание пыли и общая уборка. Доп. услуги вроде чистки духовки — как дополнения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuchyňa, kúpeľne, všetky podlahy, utieranie prachu a upratovanie. Extra služby ako čistenie rúry sú ako doplnky."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кухня, ванні кімнати, усі підлоги, витирання пилу та загальне прибирання. Додатково — чищення духовки тощо."
          }
        }
      }
    },
    "help_faq_q1": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
