        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připíšeme ho na účet pro další objednávky. Kredit nelze vyplatit a propadá 12 měsíců po posledním pohybu kreditu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripíšeme ho na účet na ďalšie objednávky. Kredit nemožno vyplatiť a prepadá 12 mesiacov po poslednom pohybe kreditu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарахуємо на ваш рахунок для наступних замовлень. Кредит не виплачується і згорає через 12 місяців після останнього руху кредиту."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачислим на ваш счёт для следующих заказов. Кредит не выплачивается и сгорает через 12 месяцев после последнего движения по кредиту."
          }
        }
      }
