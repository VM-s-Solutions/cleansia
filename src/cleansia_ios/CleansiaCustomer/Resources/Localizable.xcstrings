    "credit_none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No credit right now. If a clean goes wrong, credit we give you shows up here."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teď nemáte žádný kredit. Pokud se úklid nepovede, kredit, který vám dáme, uvidíte tady."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz nemáte žiadny kredit. Ak sa upratovanie nepodarí, kredit, ktorý vám dáme, uvidíte tu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз кредиту немає. Якщо з прибиранням щось піде не так, кредит, який ми нарахуємо, з’явиться тут."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас кредита нет. Если с уборкой что-то пойдёт не так, кредит, который мы начислим, появится здесь."
          }
        }
      }
    },
