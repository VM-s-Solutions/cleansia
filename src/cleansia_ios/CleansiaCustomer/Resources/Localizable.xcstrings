          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit se uplatní jen při platbě kartou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit sa uplatní len pri platbe kartou."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредит діє лише при оплаті карткою."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредит действует только при оплате картой."
          }
        }
      }
    },
    "booking_summary_credit_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your credit balance is %1$@. It comes off automatically, and part of every booking is always paid by card."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývá vám %1$@ kreditu. Odečte se automaticky a část každé objednávky se vždy platí kartou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostáva vám %1$@ kreditu. Odpočíta sa automaticky a časť každej objednávky sa vždy platí kartou."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш кредит — %1$@. Він списується автоматично, а частина кожного замовлення завжди сплачується карткою."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш кредит — %1$@. Он списывается автоматически, а часть каждого заказа всегда оплачивается картой."
          }
        }
      }
    },
