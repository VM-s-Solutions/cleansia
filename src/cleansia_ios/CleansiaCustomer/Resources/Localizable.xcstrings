    "booking_dirtiness_normal_lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The home is cleaned regularly, the last time about 1–2 weeks ago."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Domácnost se uklízí pravidelně, naposledy zhruba před 1–2 týdny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Domácnosť sa upratuje pravidelne, naposledy zhruba pred 1–2 týždňami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помешкання прибирають регулярно, востаннє приблизно 1–2 тижні тому."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жильё убирают регулярно, последний раз примерно 1–2 недели назад."
          }
        }
      }
    },
    "booking_dirtiness_increased_lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last cleaned 3–6 weeks ago, or a home with pets or small children."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslední úklid před 3–6 týdny, nebo domácnost se zvířaty či malými dětmi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posledné upratovanie pred 3–6 týždňami alebo domácnosť so zvieratami či malými deťmi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Останнє прибирання 3–6 тижнів тому або помешкання з тваринами чи маленькими дітьми."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя уборка 3–6 недель назад или жильё с животными либо маленькими детьми."
          }
        }
      }
    },
    "booking_dirtiness_heavy_lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than 2 months without cleaning, or a home neglected for a long time."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Déle než 2 měsíce bez úklidu, nebo dlouhodobě zanedbaná domácnost."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Viac ako 2 mesiace bez upratovania alebo dlhodobo zanedbaná domácnosť."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Понад 2 місяці без прибирання або тривалий час занедбане помешкання."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше 2 месяцев без уборки или давно запущенное жильё."
          }
        }
      }
    },
    "booking_dirtiness_normal_sign_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dust on furniture and shelves, crumbs and hair on the floor"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prach na nábytku a policích, drobečky a chlupy na podlaze"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prach na nábytku a policiach, omrvinky a chlpy na podlahe"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пил на меблях і полицях, крихти й волосся на підлозі"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пыль на мебели и полках, крошки и волосы на полу"
          }
        }
      }
    },
    "booking_dirtiness_normal_sign_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinary water marks in the bathroom, a toilet with no deposits"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V koupelně běžné vodní skvrny, WC bez usazenin"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V kúpeľni bežné vodné škvrny, WC bez usadenín"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У ванній кімнаті звичайні сліди від води, унітаз без нальоту"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ванной обычные следы от воды, унитаз без налёта"
          }
        }
      }
    },
    "booking_dirtiness_normal_sign_3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A kitchen after everyday cooking: the worktop and stove need a wipe, nothing baked on"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuchyň po běžném vaření: linka a sporák otřít, bez připečenin"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuchyňa po bežnom varení: linku a sporák utrieť, bez pripečenín"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кухня після звичайного готування: стільницю й плиту протерти, без пригорілого"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кухня после обычной готовки: столешницу и плиту протереть, без пригоревшего"
          }
        }
      }
    },
    "booking_dirtiness_normal_sign_4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dishes washed or in the dishwasher"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nádobí umyté nebo v myčce"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Riad umytý alebo v umývačke"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посуд вимитий або в посудомийній машині"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посуда вымыта или в посудомоечной машине"
          }
        }
      }
    },
    "booking_dirtiness_increased_sign_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A visible layer of dust, stains and grimy patches on the floor"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Viditelná vrstva prachu, skvrny a zašlá místa na podlaze"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Viditeľná vrstva prachu, škvrny a zašlé miesta na podlahe"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помітний шар пилу, плями й затерті місця на підлозі"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметный слой пыли, пятна и затёртые места на полу"
          }
        }
      }
    },
    "booking_dirtiness_increased_sign_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limescale on the taps, shower and bath, grimy grout"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vodní kámen na bateriích, sprchovém koutě a vaně, zašlé spáry"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vodný kameň na batériách, sprchovom kúte a vani, zašlé škáry"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вапняний наліт на змішувачах, у душовій і ванні, потемнілі шви"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Известковый налёт на смесителях, в душевой и ванне, потемневшие швы"
          }
        }
      }
    },
    "booking_dirtiness_increased_sign_3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grease on the kitchen worktop, tiles and extractor hood, an oven or microwave dirty on the outside"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mastnota na kuchyňské lince, obkladu a digestoři, znečištěná trouba nebo mikrovlnka zvenku"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mastnota na kuchynskej linke, obklade a digestore, znečistená rúra alebo mikrovlnka zvonka"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жир на кухонній стільниці, плитці й витяжці, забруднена ззовні духовка чи мікрохвильовка"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
