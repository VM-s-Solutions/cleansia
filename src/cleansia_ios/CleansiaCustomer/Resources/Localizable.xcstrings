    "dispute_settlement_credit_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added to your account for future bookings. Credit is never paid out and expires 12 months after your last credit activity."
