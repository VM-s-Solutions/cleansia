    "membership_past_due_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last Plus payment didn't go through, so your Plus benefits are paused until it does."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslední platba za Plus neprošla, takže jsou výhody Plus pozastavené, dokud neprojde."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posledná platba za Plus neprešla, takže výhody Plus sú pozastavené, kým neprejde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Останній платіж за Plus не пройшов, тому переваги Plus призупинено, доки він не пройде."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последний платёж за Plus не прошёл, поэтому преимущества Plus приостановлены, пока он не пройдёт."
          }
        }
      }
    },
    "membership_past_due_cancel_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelling ends Plus straight away: the unpaid payment is voided and nothing more is charged."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušením Plus okamžitě skončí: nezaplacená platba se zruší a nic dalšího vám nenaúčtujeme."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušením sa Plus okamžite skončí: nezaplatená platba sa zruší a nič ďalšie vám nenaúčtujeme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасування одразу завершує Plus: неоплачений платіж анулюється, і більше нічого не списується."
