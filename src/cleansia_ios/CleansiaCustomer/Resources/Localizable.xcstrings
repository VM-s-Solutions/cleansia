    "membership_perk_express_desc": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpouštíme 20%% příplatek za expresní objednávky — úklidy, které začínají 2 až 4 hodiny po objednání. Až %1$d každý kalendářní měsíc po dobu aktivního členství; nevyužité se nepřevádějí."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We waive the 20%% surcharge on express bookings — cleanings that start 2 to 4 hours after you book. Up to %1$d each calendar month while your membership is active; unused ones don't carry over."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы не берём 20 %% доплаты за экспресс-заказы — уборки, которые начинаются через 2–4 часа после оформления. До %1$d в каждый календарный месяц, пока действует ваше членство; неиспользованные не переносятся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpúšťame 20%% príplatok za expresné objednávky — upratovania, ktoré začínajú 2 až 4 hodiny po objednaní. Až %1$d každý kalendárny mesiac počas aktívneho členstva; nevyužité sa neprenášajú."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми не беремо 20 %% доплати за експрес-замовлення — прибирання, що починаються через 2–4 години після оформлення. До %1$d на кожен календарний місяць, поки діє ваше членство; невикористані не переносяться."
          }
        }
      }
    },
