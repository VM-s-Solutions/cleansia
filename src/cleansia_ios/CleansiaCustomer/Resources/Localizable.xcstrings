    "membership_disclosure": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovuje se automaticky, dokud předplatné nezrušíte. Zrušit můžete kdykoli a výhody vám zůstanou do konce zaplaceného období. Pokud platba za obnovení selže, výhody se pozastaví, dokud neprojde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews automatically until you cancel. Cancel any time and your benefits run to the end of the paid period. If a renewal payment fails, your benefits pause until it goes through."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продлевается автоматически, пока вы не отмените подписку. Отменить можно в любое время — преимущества сохранятся до конца оплаченного периода. Если платёж за продление не пройдёт, преимущества приостановятся, пока он не пройдёт."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovuje sa automaticky, kým predplatné nezrušíte. Zrušiť môžete kedykoľvek a výhody vám zostanú do konca zaplateného obdobia. Ak platba za obnovenie zlyhá, výhody sa pozastavia, kým neprejde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжується автоматично, доки ви не скасуєте підписку. Скасувати можна будь-коли — переваги діятимуть до кінця оплаченого періоду. Якщо платіж за продовження не пройде, переваги призупиняться, доки він не пройде."
          }
        }
      }
    },
