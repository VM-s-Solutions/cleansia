    "booking_dirtiness_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How clean is your home?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak moc je u vás uklizeno?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako veľmi je u vás upratané?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки у вас прибрано?"
          }
        },
        "ru": {
