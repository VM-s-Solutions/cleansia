    "push.order.no_cleaner_refunded.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody was able to take booking #%1$@, so we have refunded it in full and added %2$@ credit towards your next clean. Sorry."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Objednávku #%1$@ nikdo nestihl převzít, proto vám vracíme celou částku a přidáváme kredit %2$@ na příští úklid. Omlouváme se."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Objednávku #%1$@ nikto nestihol prevziať, preto vám vraciame celú sumu a pridávame kredit %2$@ na ďalšie upratovanie. Ospravedlňujeme sa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заказ #%1$@ никто не взял, поэтому мы вернули всю сумму и начислили %2$@ кредита на следующую уборку. Простите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замовлення #%1$@ ніхто не взяв, тому ми повернули всю суму та нарахували %2$@ кредиту на наступне прибирання. Вибачте."
          }
        }
