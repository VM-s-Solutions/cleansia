    "order_cancel_fee_split": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poplatek za zrušení %1$@ — vrátíme vám %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellation fee %1$@ — you'll be refunded %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия за отмену %1$@ — вам вернём %2$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poplatok za zrušenie %1$@ — vrátime vám %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісія за скасування %1$@ — вам повернемо %2$@."
          }
        }
      }
    },
    "order_cancel_fee_only": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poplatek za zrušení %1$@. Kartou jste nic nezaplatili, takže se nic nevrací."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellation fee %1$@. No card payment was taken, so there is nothing to refund."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия за отмену %1$@. Оплаты картой не было, поэтому возвращать нечего."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poplatok za zrušenie %1$@. Kartou ste nič nezaplatili, takže sa nič nevracia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісія за скасування %1$@. Оплати карткою не було, тож повертати нічого."
          }
        }
      }
    },
    "order_cancel_fee_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poplatek za zrušení se teď nepodařilo zjistit. Zrušit můžete i tak — částku potvrdíme při zrušení."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't check the cancellation fee just now. You can still cancel — the amount is confirmed when you do."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удалось проверить комиссию за отмену. Отменить всё равно можно — сумму подтвердим при отмене."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poplatok za zrušenie sa teraz nepodarilo zistiť. Zrušiť môžete aj tak — sumu potvrdíme pri zrušení."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не вдалося перевірити комісію за скасування. Ви все одно можете скасувати — суму підтвердимо під час скасування."
          }
        }
      }
    },
