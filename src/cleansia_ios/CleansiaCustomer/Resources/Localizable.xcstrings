    "payments_due_intro": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhraďte dlužnou částku a budete moci znovu platit v hotovosti. Objednávek placených kartou se to netýká."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay what you owe to book in cash again. Card bookings are not affected."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Погасите задолженность, чтобы снова платить наличными. Заказов с оплатой картой это не касается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhraďte dlžnú sumu a budete môcť znova platiť v hotovosti. Objednávok platených kartou sa to netýka."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сплатіть заборгованість, щоб знову платити готівкою. Замовлень з оплатою карткою це не стосується."
          }
        }
      }
    },
