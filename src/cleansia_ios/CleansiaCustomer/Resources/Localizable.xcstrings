    "payments_card_intro": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta, která zaručuje vaše objednávky v hotovosti. Může z ní být stržen storno poplatek, poplatek za neumožnění vstupu, nezaplacená hotovost nebo schválený doplatek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card that guarantees your cash bookings. A cancellation fee, a lockout fee, unpaid cash or a top-up you approved may be charged to it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта, которая гарантирует ваши заказы с оплатой наличными. С неё могут быть списаны плата за отмену, плата за непредоставление доступа, неоплаченные наличные или одобренная вами доплата."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta, ktorá zaručuje vaše objednávky v hotovosti. Môže z nej byť strhnutý stornovací poplatok, poplatok za neumožnenie vstupu, nezaplatená hotovosť alebo schválený doplatok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка, яка гарантує ваші замовлення з оплатою готівкою. З неї можуть бути списані плата за скасування, плата за ненадання доступу, неоплачена готівка або схвалена вами доплата."
          }
        }
      }
    },
