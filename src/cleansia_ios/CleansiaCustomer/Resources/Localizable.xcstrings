    "consent_early_performance_draft_2026_09_29": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádám, aby úklid začal ve 14denní lhůtě pro odstoupení od smlouvy, a beru na vědomí, že po úplném provedení úklidu právo na odstoupení ztrácím."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I ask for the cleaning to start within the 14-day withdrawal period, and I acknowledge that I lose the right to withdraw once the cleaning has been fully performed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я прошу начать уборку в течение 14-дневного срока для отказа от договора и признаю, что после полного выполнения уборки теряю право на отказ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadam, aby sa upratovanie začalo v 14-dňovej lehote na odstúpenie od zmluvy, a beriem na vedomie, že po úplnom vykonaní upratovania právo na odstúpenie strácam."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я прошу розпочати прибирання протягом 14-денного строку для відмови від договору та визнаю, що після повного виконання прибирання втрачаю право на відмову."
          }
        }
      }
    },
    "credit_auto_applied_share": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comes off your next card booking automatically, up to %1$lld%% of it."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky se odečte z vaší příští objednávky placené kartou, až do výše %1$lld %% její ceny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky sa odpočíta z vašej ďalšej objednávky platenej kartou, až do výšky %1$lld %% jej ceny."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично списується з наступного замовлення з оплатою карткою — до %1$lld%% його вартості."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически списывается со следующего заказа с оплатой картой — до %1$lld%% его стоимости."
          }
        }
      }
    },
    "credit_expires_on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expires %1$@. Every booking pushes that back."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyprší %1$@. Každá objednávka lhůtu prodlouží."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyprší %1$@. Každá objednávka lehotu predĺži."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Згорає %1$@. Кожне замовлення відсуває цю дату."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сгорает %1$@. Каждый заказ отодвигает эту дату."
          }
        }
      }
    },
    "credit_explainer_points_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Points move your tier and its discount, and are never spent. Credit is money off your bookings."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Body posouvají vaši úroveň a její slevu a nikdy se neutrácejí. Kredit jsou peníze, které se odečtou z vašich objednávek."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Body posúvajú vašu úroveň a jej zľavu a nikdy sa neminú. Kredit sú peniaze, ktoré sa odpočítajú z vašich objednávok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бали підвищують ваш рівень і його знижку та ніколи не витрачаються. Кредит — це гроші, що віднімаються від ваших замовлень."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баллы повышают ваш уровень и его скидку и никогда не тратятся. Кредит — это деньги, которые вычитаются из ваших заказов."
          }
        }
      }
    },
    "credit_explainer_points_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credit isn't points"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit nejsou body"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit nie sú body"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредит — це не бали"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредит — это не баллы"
          }
        }
      }
    },
    "credit_explainer_source_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An apology when your cleaner doesn't arrive or nobody can take your booking, a complaint you chose to settle in credit, or a goodwill gesture from us."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omluva, když uklízeč nedorazí nebo vaši objednávku nikdo nepřevezme, reklamace, kterou jste se rozhodli vyřešit kreditem, nebo vstřícné gesto od nás."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ospravedlnenie, keď upratovač nepríde alebo vašu objednávku nikto neprevezme, reklamácia, ktorú ste sa rozhodli vyriešiť kreditom, alebo ústretové gesto od nás."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибачення, коли прибиральник не приїхав або ніхто не зміг узяти ваше замовлення, скарга, яку ви вирішили врегулювати кредитом, або жест доброї волі від нас."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Извинение, когда уборщик не приехал или никто не смог взять ваш заказ, жалоба, которую вы решили урегулировать кредитом, или жест доброй воли от нас."
          }
        }
      }
    },
    "credit_explainer_source_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where it comes from"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkud se bere"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkiaľ sa berie"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звідки він береться"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откуда он берётся"
          }
        }
      }
    },
    "credit_explainer_spend_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically, on your next card booking in the same currency, up to %1$lld%% of it. The card always pays the rest."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky, na vaši příští objednávku placenou kartou ve stejné měně, až do výše %1$lld %% její ceny. Zbytek vždy zaplatíte kartou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky, na vašu ďalšiu objednávku platenú kartou v rovnakej mene, až do výšky %1$lld %% jej ceny. Zvyšok vždy zaplatíte kartou."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично, на наступне замовлення з оплатою карткою в тій самій валюті — до %1$lld%% його вартості. Решту завжди сплачує картка."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически, на следующий заказ с оплатой картой в той же валюте — до %1$lld%% его стоимости. Остаток всегда оплачивается картой."
          }
        }
      }
    },
