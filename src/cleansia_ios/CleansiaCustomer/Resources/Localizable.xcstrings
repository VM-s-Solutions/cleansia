    "preferred_offer_asked_body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezervaci pro ně držíme do %1$@. Pokud ji nemohou převzít, otevře se celému našemu týmu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We're holding this booking for them until %1$@. If they can't take it, it opens to our whole team."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы держим этот заказ для них до %1$@. Если они не смогут его взять, он откроется для всей нашей команды."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezerváciu pre nich držíme do %1$@. Ak ju nemôžu prevziať, otvorí sa celému nášmu tímu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми тримаємо це замовлення для них до %1$@. Якщо вони не зможуть його взяти, воно відкриється для всієї нашої команди."
          }
        }
      }
    },
    "preferred_offer_asked_title": {
