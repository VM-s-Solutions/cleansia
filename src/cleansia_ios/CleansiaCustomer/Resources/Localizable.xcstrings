        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dáme vedieť, keď vyrazí, začne aj skončí."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомимо, коли він вирушить, почне й завершить."
