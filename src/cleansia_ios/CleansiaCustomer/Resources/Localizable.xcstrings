    "recurring_plus_gate_subtitle": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte se k Cleansia Plus a nastavte si týdenní nebo čtrnáctidenní úklidy, které se objednají samy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join Cleansia Plus to set up weekly or biweekly cleanings that book themselves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Присоединяйтесь к Cleansia Plus, чтобы настроить еженедельные или раз в две недели уборки, которые бронируются сами."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte sa k Cleansia Plus a nastavte si týždenné alebo dvojtýždňové upratovania, ktoré sa objednajú samy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приєднайтеся до Cleansia Plus, щоб налаштувати щотижневі або раз на два тижні прибирання, які бронюються самі."
          }
        }
      }
    },
    "recurring_plus_gate_title": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opakování je výhoda Plus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recurring is a Plus perk"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регулярные — это преимущество Plus"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opakovanie je výhoda Plus"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Регулярні — це перевага Plus"
          }
        }
      }
    },
    "recurring_preferred_cleaner_refused": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U tohoto rozvrhu už nemůžeme vašeho oblíbeného uklízeče požádat jako prvního — například proto, že adresa úklidu je teď v jiné zemi. Rozvrh můžete uložit bez něj a každý úklid se pak otevře celému našemu týmu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can no longer ask your favourite cleaner first on this schedule — for example, because its address is now in another country. You can save it without them, and each cleaning will then open to our whole team."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого расписания мы больше не можем попросить вашего любимого клинера первым — например, потому что адрес уборки теперь в другой стране. Вы можете сохранить расписание без него, и тогда каждая уборка будет открыта для всей нашей команды."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri tomto rozvrhu už nemôžeme vášho obľúbeného upratovača požiadať ako prvého — napríklad preto, že adresa upratovania je teraz v inej krajine. Rozvrh môžete uložiť bez neho a každé upratovanie sa potom otvorí celému nášmu tímu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цього розкладу ми більше не можемо попросити вашого улюбленого клінера першим — наприклад, тому що адреса прибирання тепер в іншій країні. Ви можете зберегти розклад без нього, і тоді кожне прибирання буде відкрите для всієї нашої команди."
          }
        }
      }
    },
    "recurring_preferred_cleaner_save_without": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
