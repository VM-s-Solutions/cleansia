    "membership_cancel_dialog_message": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše výhody zůstanou do konce aktuálního zúčtovacího období. Další platba neproběhne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your benefits remain until the end of the current billing period. You won't be charged again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши преимущества сохранятся до конца текущего расчётного периода. Списаний больше не будет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše výhody zostanú do konca aktuálneho zúčtovacieho obdobia. Ďalšia platba neprebehne."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші переваги залишаться до кінця поточного періоду. Списань більше не буде."
          }
        }
      }
    },
    "membership_cancel_dialog_message_past_due": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus ends now. The unpaid payment is voided and you won't be charged again."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus skončí hned. Nezaplacená platba se zruší a už vám nic nenaúčtujeme."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus sa skončí hneď. Nezaplatená platba sa zruší a už vám nič nenaúčtujeme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus завершиться зараз. Неоплачений платіж буде анульовано, і з вас більше нічого не спишуть."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus завершится сейчас. Неоплаченный платёж будет аннулирован, и с вас больше ничего не спишут."
          }
        }
      }
    },
    "membership_cancel_dialog_message_trial": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkušební období skončí %1$@ a do té doby vám výhody zůstanou. Žádná platba nenásleduje, takže vám nic nenaúčtujeme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trial ends on %1$@, and your benefits stay until then. No payment follows, so you won't be charged."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробный период закончится %1$@, и до этого преимущества сохранятся. Оплаты после него не будет, поэтому с вас ничего не спишут."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúšobné obdobie skončí %1$@ a dovtedy vám výhody zostanú. Žiadna platba nenasleduje, takže vám nič nenaúčtujeme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробний період закінчиться %1$@, і до того часу переваги залишаться. Оплати після нього не буде, тож з вас нічого не спишуть."
          }
        }
      }
    },
