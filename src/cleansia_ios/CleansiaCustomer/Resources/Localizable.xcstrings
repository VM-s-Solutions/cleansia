    "push.order.preferred_offer.body": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakázka %1$@ — vyžádal si vás někdo, komu jste už uklízeli. Otevřete ji a vezměte si ji."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order %1$@ — someone you've cleaned for before requested you. Open it to take the job."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заказ %1$@ — вас попросил кто-то, у кого вы уже убирали. Откройте, чтобы взять заказ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zákazka %1$@ — vyžiadal si vás niekto, komu ste už upratovali. Otvorte ju a prevezmite ju."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замовлення %1$@ — вас попросив хтось, у кого ви вже прибирали. Відкрийте, щоб узяти замовлення."
          }
        }
      }
    },
