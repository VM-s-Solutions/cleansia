    "consent_card_guarantee_draft_2026_09_28": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhlasím, že Cleansia může u mých objednávek v hotovosti strhnout z této karty storno poplatek, poplatek za neumožnění vstupu, nezaplacenou hotovost a doplatek, který jsem schválil(a)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I agree that Cleansia may charge this card for a cancellation fee, a lockout fee, cash I did not pay and a top-up I approved on my cash bookings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я согласен(на), что по моим заказам с оплатой наличными Cleansia может списать с этой карты плату за отмену, плату за непредоставление доступа, неоплаченные наличные и одобренную мной доплату."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súhlasím, že Cleansia môže pri mojich objednávkach v hotovosti strhnúť z tejto karty stornovací poplatok, poplatok za neumožnenie vstupu, nezaplatenú hotovosť a doplatok, ktorý som schválil(a)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я погоджуюся, що за моїми замовленнями з оплатою готівкою Cleansia може списати з цієї картки плату за скасування, плату за ненадання доступу, неоплачену готівку та схвалену мною доплату."
          }
        }
      }
    },
    "booking_card_guarantee_consent_required": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro platbu v hotovosti potvrďte souhlas se zárukou kartou, nebo zvolte platbu kartou."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agree to the card guarantee to pay in cash, or choose card."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы платить наличными, согласитесь на гарантию картой или выберите оплату картой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na platbu v hotovosti potvrďte súhlas so zárukou kartou, alebo zvoľte platbu kartou."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб платити готівкою, погодьтеся на гарантію карткою або оберіть оплату карткою."
          }
        }
      }
    },
    "booking_card_guarantee_pending": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu ještě ověřujeme. Za chvíli objednávku potvrďte znovu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We're still confirming your card. Swipe again in a moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы ещё подтверждаем вашу карту. Через мгновение подтвердите заказ ещё раз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu ešte overujeme. O chvíľu objednávku potvrďte znova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми ще підтверджуємо вашу картку. За мить підтвердьте замовлення ще раз."
          }
        }
      }
    },
    "booking_card_guarantee_cancelled": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta se neuložila, takže se nic neobjednalo. Pro platbu v hotovosti si uložte kartu, nebo zvolte platbu kartou."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your card wasn't saved, so nothing was booked. Save a card to pay in cash, or choose card."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта не сохранена, поэтому ничего не забронировано. Сохраните карту, чтобы платить наличными, или выберите оплату картой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta sa neuložila, preto sa nič neobjednalo. Na platbu v hotovosti si uložte kartu, alebo zvoľte platbu kartou."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картку не збережено, тому нічого не заброньовано. Збережіть картку, щоб платити готівкою, або оберіть оплату карткою."
          }
        }
      }
    },
    "booking_save_card": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložit tuto kartu pro mé další objednávky"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save this card for my next bookings"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить эту карту для моих следующих заказов"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložiť túto kartu pre moje ďalšie objednávky"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберегти цю картку для моїх наступних замовлень"
          }
        }
      }
    },
    "booking_cash_needs_account": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotově mohou platit jen přihlášení zákazníci. Přihlaste se, pokud chcete platit hotově, nebo zaplaťte kartou."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash is only for signed-in customers. Sign in to pay in cash, or pay by card."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наличными могут платить только клиенты, вошедшие в аккаунт. Войдите, чтобы платить наличными, или оплатите картой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V hotovosti môžu platiť len prihlásení zákazníci. Prihláste sa, ak chcete platiť v hotovosti, alebo zaplaťte kartou."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готівкою можуть платити лише клієнти, які увійшли в акаунт. Увійдіть, щоб платити готівкою, або сплатіть карткою."
          }
        }
      }
    },
    "booking_cash_needs_card": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet uklízečů potřebných pro tuto objednávku: %d. Hotově lze platit jen objednávky, které zvládne jeden uklízeč, tuto proto zaplatíte kartou."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleaners needed for this booking: %d. Cash is only for bookings one cleaner handles alone, so this one is paid by card."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Количество уборщиков для этого заказа: %d. Наличными можно платить только за заказы, с которыми справится один уборщик, поэтому этот заказ оплачивается картой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet upratovačov potrebných pre túto objednávku: %d. V hotovosti sa dá platiť len za objednávky, ktoré zvládne jeden upratovač, túto preto zaplatíte kartou."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кількість прибиральників для цього замовлення: %d. Готівкою можна платити лише за замовлення, з якими впорається один прибиральник, тож це замовлення сплачується карткою."
          }
        }
      }
    },
    "booking_cash_pending": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zda můžete platit hotově, potvrdíme, jakmile bude známa cena."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether you can pay in cash is confirmed once the price is ready."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно ли платить наличными, мы подтвердим, как только будет известна цена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Či môžete platiť v hotovosti, potvrdíme, keď bude známa cena."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи можна платити готівкою, ми підтвердимо, щойно буде відома ціна."
