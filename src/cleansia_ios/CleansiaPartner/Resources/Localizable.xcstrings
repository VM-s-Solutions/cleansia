    "offer_decline_body": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihned se vrátí všem uklízečům. Nijak se vám to nezapočítává a dokud je volná, můžete si ji z nabídky vzít i vy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It goes back to every cleaner straight away. Nothing about this is held against you, and you can still take it from the board while it is free."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он сразу вернётся ко всем уборщикам. Это никак не засчитывается вам в минус, и пока он свободен, вы можете взять его из списка."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihneď sa vráti všetkým upratovačom. Nijako sa vám to nezapočítava a kým je voľná, môžete si ju z ponuky vziať aj vy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Воно одразу повернеться до всіх прибиральників. Це ніяк не зараховується вам у мінус, і поки воно вільне, ви можете взяти його зі списку."
          }
        }
      }
    },
    "offer_decline_cta": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
