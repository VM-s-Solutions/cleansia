    "push.order.cash_not_paid.body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Objednávka #%1$@ je dokončena, ale uklízeč neobdržel platbu v hotovosti. Dlužíte %2$@; uhradíte ji v profilu v sekci Platby. Do té doby nemůžete vytvořit novou objednávku."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Booking #%1$@ is completed, but the cleaner did not receive the cash payment. You owe %2$@; pay it under Payments in your profile. Until then you can't make a new booking."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заказ #%1$@ выполнен, но уборщик не получил оплату наличными. Вы должны %2$@; оплатить можно в профиле в разделе Платежи. До этого новый заказ оформить нельзя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Objednávka #%1$@ je dokončená, ale upratovač nedostal platbu v hotovosti. Dlhujete %2$@; uhradíte ju v profile v sekcii Platby. Dovtedy nemôžete vytvoriť novú objednávku."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замовлення #%1$@ виконано, але прибиральник не отримав оплату готівкою. Ви винні %2$@; сплатити можна в профілі в розділі Платежі. Доти нове замовлення оформити не можна."
          }
        }
      }
    },
