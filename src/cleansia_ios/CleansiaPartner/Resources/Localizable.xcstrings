    "cash_hidden_back": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátí se, až budete mít %1$@ nebo méně: odevzdejte hotovost, nebo se započte proti vaší další výplatě."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They come back once you hold %1$@ or less: hand cash over, or it is set off against your next payout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они вернутся, когда у вас будет %1$@ или меньше: сдайте наличные, или их зачтут в счёт следующей выплаты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátia sa, keď budete mať %1$@ alebo menej: odovzdajte hotovosť, alebo sa započíta proti vašej ďalšej výplate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вони повернуться, коли у вас буде %1$@ або менше: передайте готівку, або її зарахують у рахунок наступної виплати."
          }
        }
      }
    },
