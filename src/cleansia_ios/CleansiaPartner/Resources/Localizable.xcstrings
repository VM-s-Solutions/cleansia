    "document_replace_message": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor %@ se stane aktuální verzí a půjde znovu ke kontrole. Nic se nesmaže a po celou dobu kontroly můžete dál pracovat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ becomes the current version and goes back for review. Nothing is deleted, and you keep access to work while we look at it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %@ станет текущей версией и уйдёт на повторную проверку. Ничего не удаляется, и вы можете продолжать работать, пока мы проверяем."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbor %@ sa stane aktuálnou verziou a pôjde znova na kontrolu. Nič sa nevymaže a počas kontroly môžete ďalej pracovať."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %@ стане поточною версією та піде на повторну перевірку. Нічого не видаляється, і ви можете працювати далі, поки ми перевіряємо."
          }
        }
      }
    },
