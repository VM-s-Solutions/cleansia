          }
        }
      }
    },
    "delete_account_error_blocked_by_unsettled_pay": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále máte nevyplacenou odměnu. Až bude výplatní období vyplaceno, můžete o smazání požádat znovu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
