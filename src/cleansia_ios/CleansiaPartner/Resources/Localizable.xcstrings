    "job_radius_explainer": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mění se jen to, na které nové zakázky vás upozorníme. Nabídka dál zobrazuje všechny zakázky ve vaší zemi a kteroukoli z nich si můžete vzít."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changes only which new jobs we notify you about. The job board still lists every job in your country, and you can take any of them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это меняет только то, о каких новых заказах мы вам сообщаем. В списке по-прежнему есть все заказы в вашей стране, и вы можете взять любой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mení sa len to, na ktoré nové zákazky vás upozorníme. Ponuka naďalej zobrazuje všetky zákazky vo vašej krajine a ktorúkoľvek si môžete vziať."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це змінює лише те, про які нові замовлення ми вас сповіщаємо. У списку й далі є всі замовлення у вашій країні, і ви можете взяти будь-яке."
          }
        }
      }
    },
    "job_radius_limit_label": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorňovat jen na zakázky v okolí"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only notify me about nearby jobs"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомлять только о заказах поблизости"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorňovať len na zákazky v okolí"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщати лише про замовлення поблизу"
          }
        }
      }
    },
    "job_radius_limit_off_hint": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Budeme vás upozorňovat na každou novou zakázku ve vaší zemi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll notify you about every new job in your country."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы будем сообщать вам о каждом новом заказе в вашей стране."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Budeme vás upozorňovať na každú novú zákazku vo vašej krajine."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми сповіщатимемо вас про кожне нове замовлення у вашій країні."
          }
        }
      }
    },
    "job_radius_prompt_body": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teď vás upozorňujeme na každou novou zakázku ve vaší zemi. Vyberte vzdálenost od domova a uslyšíte jen o těch blízkých — v nabídce uvidíte dál všechny."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right now we notify you about every new job in your country. Pick a distance from home to hear only about the ones near you — the board still shows them all."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас мы сообщаем вам о каждом новом заказе в вашей стране. Выберите расстояние от дома, чтобы слышать только о ближайших — в списке по-прежнему будут все."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz vás upozorňujeme na každú novú zákazku vo vašej krajine. Vyberte vzdialenosť od domova a budete počuť len o tých blízkych — v ponuke uvidíte naďalej všetky."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз ми сповіщаємо вас про кожне нове замовлення у вашій країні. Виберіть відстань від дому, щоб чути лише про ті, що поруч — у списку й далі будуть усі."
          }
        }
      }
    },
    "job_radius_prompt_choose": {
