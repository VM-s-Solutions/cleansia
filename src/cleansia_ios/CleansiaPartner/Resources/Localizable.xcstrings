    "lockout_reported_body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahlášeno v %1$@. Administrátor to potvrdí; do té doby zakázka zůstává beze změny."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reported at %1$@. An administrator will confirm it; until then the job stays as it is."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщено в %1$@. Администратор это подтвердит; до тех пор заказ остаётся без изменений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahlásené o %1$@. Administrátor to potvrdí; dovtedy zákazka zostáva bez zmeny."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлено о %1$@. Адміністратор це підтвердить; до того замовлення залишається без змін."
          }
        }
      }
    },
