    "earnings_cash_held_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotovost, kterou jste převzali u dveří a ještě neodevzdali. Započte se proti vaší další výplatě."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash you took at the door and have not handed over yet. It is set off against your next payout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наличные, которые вы получили у двери и ещё не сдали. Они будут зачтены в счёт вашей следующей выплаты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotovosť, ktorú ste prevzali pri dverách a ešte ste ju neodovzdali. Započíta sa proti vašej ďalšej výplate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готівка, яку ви отримали біля дверей і ще не передали. Її буде зараховано в рахунок вашої наступної виплати."
          }
        }
      }
    },
