    "offer_blocked_body": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nTohle je na nás — rezervovali jsme zakázku na vaše jméno, aniž bychom to ověřili, takže se vám to nijak nezapočítává."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nThat one is on us — we put your name on this job without checking, so nothing here counts against you."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nЭто наша вина — мы зарезервировали заказ на ваше имя без проверки, так что это никак не засчитывается вам в минус."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nToto je na nás — rezervovali sme zákazku na vaše meno bez overenia, takže sa vám to nijako nezapočítava."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nЦе наша провина — ми зарезервували замовлення на ваше ім'я без перевірки, тож це ніяк не зараховується вам у мінус."
          }
        }
      }
    },
