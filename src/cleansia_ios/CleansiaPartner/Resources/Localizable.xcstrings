    "splash_unreachable_message": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte připojení a zkuste to znovu. S vaším účtem je vše v pořádku — jen se nám ho nepodařilo načíst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again. Your account is fine — we just couldn't load it."
