    "offer_release_failed_body": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nNic se neuvolnilo — zakázka je přesně tak, jak byla, a za chvíli to můžete zkusit znovu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nNothing was released — the job is exactly as it was, and you can try again in a moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nНичего не освобождено — заказ точно такой, каким был, и через мгновение вы можете попробовать снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nNič sa neuvoľnilo — zákazka je presne taká, aká bola, a o chvíľu to môžete skúsiť znova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nНічого не звільнено — замовлення точно таке, як було, і за мить ви можете спробувати ще раз."
          }
        }
      }
    },
