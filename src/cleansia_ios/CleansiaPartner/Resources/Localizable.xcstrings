        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте подключение и попробуйте снова. С вашим аккаунтом всё в порядке — мы просто не смогли его загрузить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte pripojenie a skúste to znova. S vaším účtom je všetko v poriadku — len sa nám ho nepodarilo načítať."
