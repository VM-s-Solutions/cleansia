    "lockout_sheet_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznamenejte si, kdy jste zákazníkovi volali nebo psali a co se stalo. Administrátor si to přečte spolu s vaší fotkou."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note when you called or messaged the customer and what happened. The administrator reads it with your photo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите, когда вы звонили или писали клиенту и что произошло. Администратор прочитает это вместе с вашим фото."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznačte si, kedy ste zákazníkovi volali alebo písali a čo sa stalo. Administrátor si to prečíta spolu s vašou fotkou."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть, коли ви телефонували або писали клієнту і що сталося. Адміністратор прочитає це разом із вашим фото."
          }
        }
      }
    },
