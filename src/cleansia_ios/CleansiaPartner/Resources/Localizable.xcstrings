    "document_request_deletion_message": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím se nic neodstraní. Některé dokumenty musíme uchovávat, proto vaši žádost posoudí administrátor — do jeho odpovědi zůstává dokument beze změny."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is removed yet. Some of these documents we have to keep, so an admin reviews your request — the document stays exactly as it is until they answer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ничего не удаляется. Некоторые документы мы обязаны хранить, поэтому ваш запрос рассмотрит администратор — до ответа документ остаётся без изменений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ sa nič neodstráni. Niektoré dokumenty musíme uchovávať, preto vašu žiadosť posúdi administrátor — do jeho odpovede zostáva dokument bez zmeny."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки що нічого не видаляється. Деякі документи ми зобов'язані зберігати, тому ваш запит розгляне адміністратор — до відповіді документ залишається без змін."
          }
        }
      }
    },
