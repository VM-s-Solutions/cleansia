    "cash_held_hint": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad limitem se zakázky za hotové skryjí, dokud hotovost neodevzdáte nebo se nezapočte proti výplatě."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above the limit, cash jobs are hidden until you hand cash over or it is set off against a payout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверх лимита заказы с наличными скрыты, пока вы не сдадите наличные или их не зачтут в счёт выплаты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad limitom sa zákazky za hotovosť skryjú, kým hotovosť neodovzdáte alebo sa nezapočíta proti výplate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Понад ліміт замовлення з готівкою приховано, доки ви не передасте готівку або її не зарахують у рахунок виплати."
          }
        }
      }
    },
