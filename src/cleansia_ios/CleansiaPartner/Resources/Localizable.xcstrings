    "accept_terms": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhlasím s [obchodními podmínkami](cleansia://terms) a [zásadami ochrany soukromí](cleansia://privacy)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I accept the [Terms and Conditions](cleansia://terms) and the [Privacy Policy](cleansia://privacy)"
