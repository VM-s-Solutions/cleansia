    "earnings_cash_held_jobs_hidden": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Držíte více, než je limit, proto se vám zakázky za hotové nezobrazují, dokud hotovost neodevzdáte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You hold more than the limit, so cash jobs are hidden from you until you hand cash over."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас больше лимита, поэтому заказы с оплатой наличными скрыты, пока вы не сдадите наличные."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Držíte viac, než je limit, preto sa vám zákazky za hotovosť nezobrazujú, kým hotovosť neodovzdáte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас більше, ніж дозволяє ліміт, тому замовлення з оплатою готівкою приховані, доки ви не передасте готівку."
          }
        }
      }
    },
