    "delete_account_body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahájíme proces ukončení spolupráce. Spolupráce musí být formálně ukončena osobně a je nutné podepsat zbývající dokumenty, teprve poté bude účet uzavřen — dnes se tedy nic nemění a můžete dál pracovat na zakázkách, které již máte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll start the offboarding process. Your cooperation has to be formally ended in person and any outstanding paperwork signed before your account is closed — so nothing changes today, and you can keep working on the jobs you already have."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы начнём процесс завершения сотрудничества. Сотрудничество нужно официально завершить лично и подписать оставшиеся документы, и только после этого аккаунт будет закрыт — сегодня ничего не меняется, и вы можете продолжать работать над текущими заказами."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Začneme proces ukončenia spolupráce. Spolupráca musí byť formálne ukončená osobne a je potrebné podpísať zostávajúce dokumenty, až potom bude účet uzavretý — dnes sa teda nič nemení a môžete ďalej pracovať na zákazkách, ktoré už máte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми розпочнемо процес завершення співпраці. Співпрацю потрібно офіційно завершити особисто та підписати документи, що залишилися, і лише після цього акаунт буде закрито — тож сьогодні нічого не змінюється, і ви можете продовжувати працювати над наявними замовленнями."
          }
        }
      }
    },
    "delete_account_cta": {
