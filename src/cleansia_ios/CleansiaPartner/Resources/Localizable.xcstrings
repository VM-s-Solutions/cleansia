    "lockout_card_body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyfoťte vchod, poznamenejte si, kdy jste zákazníkovi volali, a nahlaste to. Než se uplatní jakýkoli poplatek, potvrdí to administrátor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo of the entrance, note when you called the customer, and report it. An administrator confirms it before any fee applies."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфотографируйте вход, запишите, когда вы звонили клиенту, и сообщите об этом. Администратор подтверждает это, прежде чем будет применён какой-либо сбор."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odfoťte vchod, poznačte si, kedy ste zákazníkovi volali, a nahláste to. Skôr než sa uplatní akýkoľvek poplatok, potvrdí to administrátor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфотографуйте вхід, запишіть, коли ви телефонували клієнту, і повідомте про це. Адміністратор підтверджує це, перш ніж буде застосовано будь-який збір."
          }
        }
      }
    },
    "lockout_card_not_yet": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud vám nikdo neotevře, můžete to nahlásit od %1$@, %2$d minut po začátku."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If nobody opens the door, you can report it from %1$@, %2$d minutes after the start."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вам никто не открывает, вы можете сообщить об этом с %1$@, через %2$d минут после начала."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak vám nikto neotvorí, môžete to nahlásiť od %1$@, %2$d minút po začiatku."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вам ніхто не відчиняє, ви можете повідомити про це з %1$@, через %2$d хвилин після початку."
          }
        }
      }
    },
