    "take_sheet_title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzít tuto zakázku?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take this job?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взять этот заказ?"
          }
        },
        "sk": {
