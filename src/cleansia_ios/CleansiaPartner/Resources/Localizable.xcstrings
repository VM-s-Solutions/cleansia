    "take_cancel_free_until": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdarma ji zrušíte do %1$@, pokud k ní ještě nikdo nevyrazil ani ji nezačal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free to cancel until %1$@, as long as nobody on the job has set off or started."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно отменить можно до %1$@, если ещё никто не выехал на него и не начал."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadarmo ju zrušíte do %1$@, ak k nej ešte nikto nevyrazil ani ju nezačal."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовно скасувати можна до %1$@, якщо ще ніхто не виїхав на нього і не почав."
          }
        }
      }
    },
    "take_cancel_start_passed": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas začátku už uplynul, takže jakmile ji vezmete, v aplikaci ji zrušit nejde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its start time has passed, so once you take it you can't cancel it in the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время начала уже прошло, поэтому, взяв его, отменить в приложении не получится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas začiatku už uplynul, takže keď ju vezmete, v aplikácii ju zrušiť nejde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час початку вже минув, тож, узявши його, скасувати в застосунку не вийде."
          }
        }
      }
    },
    "take_cancel_under_way": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakázka už probíhá: uvedená odměna je plná odměna za vaše místo. Jakmile ji vezmete, v aplikaci ji zrušit nejde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This job is already under way: the reward shown is the full reward for your place. Once you take it, you can't cancel it in the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заказ уже выполняется: показанное вознаграждение — полное вознаграждение за ваше место. Взяв его, отменить в приложении не получится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zákazka už prebieha: uvedená odmena je plná odmena za vaše miesto. Keď ju vezmete, v aplikácii ju zrušiť nejde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замовлення вже виконується: показана винагорода — повна винагорода за ваше місце. Узявши його, скасувати в застосунку не вийде."
          }
        }
      }
    },
    "take_cash_line": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zákazník vám zaplatí %1$@ hotově. Hotovost patří společnosti a započte se proti vaší příští výplatě. Vaše odměna zůstává %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The customer pays you %1$@ in cash. The cash belongs to the company and is set off against your next payout. Your reward stays %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клиент заплатит вам %1$@ наличными. Наличные принадлежат компании и засчитываются в счёт вашей следующей выплаты. Ваше вознаграждение — %2$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zákazník vám zaplatí %1$@ v hotovosti. Hotovosť patrí spoločnosti a započíta sa proti vašej ďalšej výplate. Vaša odmena zostáva %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клієнт заплатить вам %1$@ готівкою. Готівка належить компанії й зараховується в рахунок вашої наступної виплати. Ваша винагорода — %2$@."
          }
        }
      }
    },
    "take_done_cannot_cancel": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto zakázku v aplikaci zrušit nejde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't cancel this job in the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить этот заказ в приложении не получится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Túto zákazku v aplikácii zrušiť nejde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати це замовлення в застосунку не вийде."
          }
        }
      }
