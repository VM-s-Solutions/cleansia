    "push.order.no_cleaner_refund_pending.body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na objednávku #%1$@ nemohl dorazit žádný uklízeč, proto jsme ji zrušili. Vrácení peněz je na cestě a přidali jsme vám kredit %2$@ na příští úklid. Omlouváme se."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cleaner could make it to booking #%1$@, so we have cancelled it. Your refund is on its way, and we have added %2$@ credit towards your next clean. Sorry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На заказ #%1$@ не смог приехать ни один уборщик, поэтому мы его отменили. Возврат средств обрабатывается, а ещё мы начислили %2$@ кредита на следующую уборку. Простите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na objednávku #%1$@ nemohol prísť žiadny upratovač, preto sme ju zrušili. Vrátenie peňazí je na ceste a pridali sme vám kredit %2$@ na ďalšie upratovanie. Ospravedlňujeme sa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На замовлення #%1$@ не зміг приїхати жоден прибиральник, тому ми його скасували. Повернення коштів обробляється, а ще ми нарахували %2$@ кредиту на наступне прибирання. Вибачте."
          }
        }
      }
    },
