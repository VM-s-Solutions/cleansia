    "legal_documents_intro": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto dokumenty upravují vaši práci pro provozní společnost trhu, na kterém pracujete. Každý si přečtěte a přijměte jeho aktuální verzi — dokud to neuděláte, nemůžete být schváleni ani přijímat zakázky."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These documents govern your work for the operating company of the market you work in. Read each one and accept its current version — until you do, you can't be approved or take jobs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти документы регулируют вашу работу для операционной компании рынка, на котором вы работаете. Прочитайте каждый и примите его действующую версию — пока вы этого не сделаете, вас не смогут одобрить и вы не сможете брать заказы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto dokumenty upravujú vašu prácu pre prevádzkovú spoločnosť trhu, na ktorom pracujete. Každý si prečítajte a prijmite jeho aktuálnu verziu — kým to neurobíte, nemôžete byť schválení ani prijímať zákazky."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці документи регулюють вашу роботу для операційної компанії ринку, на якому ви працюєте. Прочитайте кожен і прийміть його чинну версію — доки ви цього не зробите, вас не можуть схвалити і ви не можете брати замовлення."
          }
        }
      }
    },
    "legal_documents_new_version": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
