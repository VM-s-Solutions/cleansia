        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrďte, že jste od zákazníka převzali %1$@ v hotovosti. Tuto akci nelze vzít zpět."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm you have taken %1$@ in cash from the customer. This cannot be undone."
          }
