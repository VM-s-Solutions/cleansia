    "job_photos_camera_only": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografie k zakázce lze pořídit jen fotoaparátem, nelze je vybrat z galerie. K jejich přidání použijte telefon s fotoaparátem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Job photos can only be taken with the camera, not chosen from the gallery. Use a phone with a camera to add them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото к заказу можно сделать только камерой, выбрать их из галереи нельзя. Чтобы добавить их, воспользуйтесь телефоном с камерой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografie k zákazke sa dajú urobiť len fotoaparátom, nedajú sa vybrať z galérie. Na ich pridanie použite telefón s fotoaparátom."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото до замовлення можна зробити лише камерою, вибрати їх із галереї не можна. Щоб додати їх, скористайтеся телефоном із камерою."
          }
        }
      }
