    "cash_rule": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotovost patří společnosti a započte se proti vaší příští výplatě. Vaše odměna zůstává %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cash belongs to the company and is set off against your next payout. Your reward stays %1$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наличные принадлежат компании и засчитываются в счёт вашей следующей выплаты. Ваше вознаграждение остаётся %1$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotovosť patrí spoločnosti a započíta sa proti vašej ďalšej výplate. Vaša odmena zostáva %1$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готівка належить компанії й зараховується в рахунок вашої наступної виплати. Ваша винагорода — %1$@."
          }
        }
      }
