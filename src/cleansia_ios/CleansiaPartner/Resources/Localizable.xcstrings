          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите, что вы получили от клиента %1$@ наличными. Это действие нельзя отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrďte, že ste od zákazníka prevzali %1$@ v hotovosti. Túto akciu nemožno vrátiť späť."
