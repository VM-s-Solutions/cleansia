    "accept_terms": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhlasím s [obchodními podmínkami](cleansia://terms) a [zásadami ochrany soukromí](cleansia://privacy)"
