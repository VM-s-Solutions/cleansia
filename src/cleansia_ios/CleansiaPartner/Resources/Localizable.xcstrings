      }
    },
    "order_drop_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Budete ze zakázky odebráni a vaše místo se vrátí do nabídky ostatním uklízečům. Objednávka zákazníka se neruší. Pokud jste na zakázce jediný uklízeč, nebude mít žádného uklízeče, dokud si ji někdo nevezme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will be taken off this job and your place goes back on the board for other cleaners. The customer's booking is not cancelled. If you are the only cleaner on it, the job has no cleaner until someone takes it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас снимут с этого заказа, а ваше место вернётся в список для других уборщиков. Заказ клиента не отменяется. Если вы единственный уборщик на нём, у заказа не будет уборщика, пока его кто-нибудь не возьмёт."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Budete zo zákazky odobratí a vaše miesto sa vráti do ponuky ostatným upratovačom. Objednávka zákazníka sa neruší. Ak ste na zákazke jediný upratovač, nebude mať žiadneho upratovača, kým si ju niekto nevezme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас буде знято з цього замовлення, а ваше місце повернеться до списку для інших прибиральників. Замовлення клієнта не скасовується. Якщо ви єдиний прибиральник на ньому, замовлення не матиме прибиральника, доки його хтось не візьме."
          }
        }
      }
    },
    "order_drop_confirm_action": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
