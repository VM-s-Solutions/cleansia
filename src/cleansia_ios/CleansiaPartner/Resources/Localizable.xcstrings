    "delete_account_dialog_message": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozveme se vám a spolupráci formálně ukončíme. Dnes se nic nemaže."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll contact you to end the cooperation formally. Nothing is deleted today."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы свяжемся с вами и официально завершим сотрудничество. Сегодня ничего не удаляется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
