          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажуємо договір…"
          }
        }
      }
    },
    "work_contract_summary_complaint": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za reklamaci platíte, jen když společnost shledá, že jste ji zavinili."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A complaint costs you only if the company finds you at fault."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За жалобу вы платите, только если компания признает, что виноваты вы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Za reklamáciu platíte, len keď spoločnosť zistí, že ste ju zavinili."
