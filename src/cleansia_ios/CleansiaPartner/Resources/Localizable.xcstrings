    "offer_declined_toast": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvolněno — zakázka je teď otevřená všem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Released — the job is open to every cleaner now."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освобождено — заказ теперь открыт для всех."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvoľnené — zákazka je teraz otvorená všetkým."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звільнено — замовлення тепер відкрите для всіх."
          }
        }
      }
    },
    "offer_empty": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Právě teď na vaši odpověď nic nečeká."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is waiting for your answer right now."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас ничего не ждёт вашего ответа."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Práve teraz na vašu odpoveď nič nečaká."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз нічого не чекає на вашу відповідь."
          }
        }
      }
    },
    "offer_release_failed_body": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nNic se neuvolnilo — zakázka je přesně tak, jak byla, a za chvíli to můžete zkusit znovu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nNothing was released — the job is exactly as it was, and you can try again in a moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nНичего не освобождено — заказ точно такой, каким был, и через мгновение вы можете попробовать снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nNič sa neuvoľnilo — zákazka je presne taká, aká bola, a o chvíľu to môžete skúsiť znova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nНічого не звільнено — замовлення точно таке, як було, і за мить ви можете спробувати ще раз."
          }
        }
      }
    },
    "offer_release_failed_title": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
