    "offers_subtitle": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakázky, o které si vás zákazník vyžádal. Když potvrdíte, jsou vaše; když odmítnete, vrátí se všem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jobs a customer asked you for. Confirm one and it is yours; decline and it goes back to everyone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заказы, в которых клиент попросил именно вас. Подтвердите — они ваши; откажетесь — вернутся ко всем."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zákazky, o ktoré si vás zákazník vyžiadal. Keď potvrdíte, sú vaše; keď odmietnete, vrátia sa všetkým."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замовлення, у яких клієнт попросив саме вас. Підтвердите — вони ваші; відмовитеся — повернуться до всіх."
          }
        }
