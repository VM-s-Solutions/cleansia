    "take_team_line": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Aplikace mezi vás práci nedělí a nemůžete si vzít jinou zakázku, která se kryje s jejím rezervovaným časem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. The app doesn't divide the work between you, and you can't take another job that overlaps this job's booked time."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Приложение не делит работу между вами, и вы не можете взять другой заказ, который пересекается с его забронированным временем."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Aplikácia medzi vás prácu nedelí a nemôžete si vziať inú zákazku, ktorá sa prekrýva s jej rezervovaným časom."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Застосунок не ділить роботу між вами, і ви не можете взяти інше замовлення, що перетинається з його заброньованим часом."
          }
        }
      }
    },
    "work_contract_loading": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načítáme smlouvu…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading the contract…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
