    "delete_account_error_blocked_by_assigned_order": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále jste přiřazeni k nadcházející zakázce. Až bude dokončena nebo přeřazena, můžete o smazání požádat znovu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're still assigned to an upcoming job. Once it's finished or reassigned you can request deletion again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы всё ещё назначены на предстоящий заказ. Когда он будет выполнен или передан, вы сможете отправить запрос снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále ste priradení k nadchádzajúcej zákazke. Keď bude dokončená alebo preradená, môžete o zmazanie požiadať znova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви досі призначені на майбутнє замовлення. Коли воно буде завершене або передане, ви зможете надіслати запит знову."
          }
        }
      }
    },
    "delete_account_error_blocked_by_invoice": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vašem účtu je stále otevřená faktura. Až bude vyrovnána, můžete o smazání požádat znovu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's still an open invoice on your account. Once it's settled you can request deletion again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашем аккаунте всё ещё есть открытый счёт. Когда он будет закрыт, вы сможете отправить запрос снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vašom účte je stále otvorená faktúra. Keď bude vyrovnaná, môžete o zmazanie požiadať znova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашому акаунті досі є відкритий рахунок. Коли його буде закрито, ви зможете надіслати запит знову."
          }
        }
      }
    },
    "delete_account_error_blocked_by_order": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte aktivní objednávku. Až bude dokončena, můžete o smazání požádat znovu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have an active order. Once it's finished you can request deletion again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас есть активный заказ. Когда он будет завершён, вы сможете отправить запрос снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte aktívnu objednávku. Keď bude dokončená, môžete o zmazanie požiadať znova."
