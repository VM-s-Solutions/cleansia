    "push.order.cleaner_released.body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezervaci #%1$@ znovu nabízíme našim uklízečům a dáme vám vědět, jakmile ji někdo převezme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We're offering booking #%1$@ to our cleaners again and will let you know as soon as one takes it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы снова предлагаем заказ #%1$@ нашим клинерам и сообщим вам, как только кто-то его возьмёт."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezerváciu #%1$@ opäť ponúkame našim upratovačom a dáme vám vedieť, hneď ako ju niekto prevezme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми знову пропонуємо замовлення #%1$@ нашим клінерам і повідомимо вас, щойно хтось його візьме."
          }
        }
      }
    },
